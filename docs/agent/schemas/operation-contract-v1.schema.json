{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodex.dev/schemas/operation-contract-v1.schema.json",
  "title": "NodeX Operation Contract v1",
  "type": "object",
  "required": ["id", "path", "description", "argument_syntax", "arguments", "flags", "input_schema", "target_requirement", "local_side_effects", "remote_side_effects", "safety_tier", "risks", "confirmation_requirements", "interactive", "submits_task", "verification", "recovery", "structured_output", "legacy_output_modes", "agent_supported", "provider_support_note", "provider_permission_note"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*$" },
    "path": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "description": { "type": "string", "minLength": 1 },
    "argument_syntax": { "type": "string" },
    "arguments": { "type": "array", "items": { "type": "object", "required": ["name", "type", "required", "syntax"], "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "required": { "type": "boolean" }, "choices": { "type": "array", "items": { "type": "string" } }, "syntax": { "type": "string" }, "description": { "type": "string" } } } },
    "flags": { "type": "array", "items": { "type": "object", "required": ["name", "type", "required"], "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "required": { "type": "boolean" }, "value_syntax": { "type": "string" }, "default": {}, "choices": { "type": "array", "items": { "type": "string" } }, "minimum": {}, "maximum": {}, "pattern": { "type": "string" }, "format": { "type": "string" }, "description": { "type": "string" } } } },
    "input_schema": { "type": "object" },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "target_requirement": { "type": "string" },
    "local_side_effects": { "type": "array", "items": { "type": "string" } },
    "remote_side_effects": { "type": "array", "items": { "type": "string" } },
    "safety_tier": { "enum": ["observation", "reversible", "disruptive", "destructive", "security_admin"] },
    "risks": { "type": "array", "items": { "type": "string" } },
    "confirmation_requirements": { "type": "array", "items": { "type": "string" } },
    "provider_interface": { "type": "string" },
    "interactive": { "type": "boolean" },
    "submits_task": { "type": "boolean" },
    "verification": { "type": "array", "items": { "type": "string" } },
    "recovery": { "type": "array", "items": { "type": "string" } },
    "structured_output": { "type": "array", "items": { "type": "string" } },
    "legacy_output_modes": { "type": "array", "items": { "type": "string" } },
    "agent_supported": { "type": "boolean" },
    "agent_unsupported_reason": { "type": "string" },
    "provider_support_note": { "type": "string" },
    "provider_permission_note": { "type": "string" }
  }
}
