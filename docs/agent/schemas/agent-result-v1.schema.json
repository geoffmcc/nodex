{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodex.dev/schemas/agent-result-v1.schema.json",
  "title": "NodeX Agent Result v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "request_id", "operation", "context", "submission",
    "execution", "verification", "changed", "retry", "started_at", "observed_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "receipt_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "operation": { "type": "string", "minLength": 1 },
    "context": { "$ref": "#/$defs/executionContext" },
    "submission": { "enum": ["not_attempted", "accepted", "rejected", "unknown"] },
    "execution": { "enum": ["not_started", "running", "succeeded", "failed", "unknown"] },
    "verification": { "enum": ["not_requested", "passed", "failed", "unknown", "unsupported"] },
    "changed": { "type": ["boolean", "null"] },
    "retry": { "enum": ["safe", "reconcile_first", "do_not_retry_automatically"] },
    "task_id": { "type": "string", "maxLength": 1024 },
    "started_at": { "type": "string", "format": "date-time" },
    "observed_at": { "type": "string", "format": "date-time" },
    "error": { "$ref": "#/$defs/error" },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" }, "maxItems": 64 },
    "next_actions": { "type": "array", "items": { "$ref": "#/$defs/nextAction" }, "maxItems": 32 },
    "observation": { "$ref": "#/$defs/observation" },
    "data": {}
  },
  "allOf": [
    {
      "if": { "properties": { "submission": { "const": "not_attempted" } }, "required": ["submission"] },
      "then": { "properties": { "execution": { "enum": ["not_started", "succeeded", "failed"] } } }
    },
    {
      "if": { "properties": { "submission": { "const": "rejected" } }, "required": ["submission"] },
      "then": { "properties": { "execution": { "const": "not_started" } } }
    },
    {
      "if": { "properties": { "submission": { "const": "accepted" } }, "required": ["submission"] },
      "then": { "properties": { "execution": { "enum": ["running", "succeeded", "failed", "unknown"] } } }
    },
    {
      "if": { "properties": { "submission": { "const": "unknown" } }, "required": ["submission"] },
      "then": {
        "properties": {
          "execution": { "enum": ["running", "unknown"] },
          "retry": { "const": "reconcile_first" }
        }
      }
    },
    {
      "if": { "properties": { "execution": { "const": "running" } }, "required": ["execution"] },
      "then": { "properties": { "retry": { "const": "reconcile_first" } } }
    },
    {
      "if": {
        "properties": {
          "submission": { "const": "accepted" },
          "execution": { "const": "unknown" }
        },
        "required": ["submission", "execution"]
      },
      "then": { "properties": { "retry": { "const": "reconcile_first" } } }
    },
    {
      "if": { "properties": { "execution": { "const": "failed" } }, "required": ["execution"] },
      "then": { "properties": { "retry": { "const": "do_not_retry_automatically" } } }
    },
    {
      "if": {
        "properties": {
          "submission": { "const": "accepted" },
          "execution": { "enum": ["succeeded", "failed"] }
        },
        "required": ["submission", "execution"]
      },
      "then": { "properties": { "retry": { "const": "do_not_retry_automatically" } } }
    },
    {
      "if": { "properties": { "verification": { "const": "passed" } }, "required": ["verification"] },
      "then": { "properties": { "execution": { "const": "succeeded" } } }
    },
    {
      "if": { "properties": { "verification": { "const": "failed" } }, "required": ["verification"] },
      "then": {
        "properties": {
          "submission": { "const": "accepted" },
          "execution": { "const": "succeeded" }
        }
      }
    }
  ],
  "$defs": {
    "executionContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "type": "string" },
        "provider": { "type": "string" },
        "endpoint": { "type": "string", "format": "uri" },
        "resource_type": { "type": "string" },
        "resource_id": { "type": "string" },
        "related_targets": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resource_type", "resource_id"],
            "properties": {
              "resource_type": { "type": "string" },
              "resource_id": { "type": "string" },
              "node": { "type": "string" },
              "namespace": { "type": "string" }
            }
          }
        },
        "node": { "type": "string" },
        "namespace": { "type": "string" },
        "endpoint_identity": { "type": "string" },
        "tls_ca_file": { "type": "string" },
        "ssh_host": { "type": "string" },
        "ssh_user": { "type": "string" },
        "ssh_key_file": { "type": "string" },
        "ssh_known_hosts_file": { "type": "string" },
        "ssh_inventory_host": { "type": "string" },
        "ssh_port": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "exit_code"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "maxLength": 4200 },
        "exit_code": { "type": "integer" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "maxLength": 4200 }
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation"],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "arguments": { "type": "object", "additionalProperties": true }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "completeness", "truncated", "partial"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "completeness": { "enum": ["complete", "partial", "unknown"] },
        "truncated": { "type": "boolean" },
        "partial": { "type": "boolean" },
        "unsupported": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
